{
  "id": "cross-harp-call-response",
  "title": "二把位呼应练习",
  "subtitle": "Cross-Harp Call and Response",
  "composer": "HarpScore 原创练习曲",
  "key": "G",
  "harmonicaKey": "C",
  "position": "第二把位",
  "timeSignature": "4/4",
  "tempo": 80,
