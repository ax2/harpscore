{
  "id": "flying-kites",
  "title": "放纸鹞",
  "subtitle": "台湾民谣《一只鸟仔》曲调",
  "composer": "台湾民谣",
  "key": "C",
  "harmonicaKey": "C",
  "timeSignature": "4/4",
  "tempo": 96,
