{
  "name": "harpscore",
  "version": "0.2.0",
  "description": "HarpScore - 跨平台布鲁斯口琴乐谱软件：琴谱展示、管理与导出",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "scores:build": "tsx tools/build-scores.ts",
    "scores:validate": "tsx tools/validate-scores.ts",
    "release:pack": "node tools/package-release.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.20.5",
    "typescript": "~5.6.3",
    "vite": "^8.2.2"
  }
}
